{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "custom": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "base",
          "color": "#ffffff",
          "name": "Base"
        },
        {
          "slug": "contrast",
          "color": "#0f172a",
          "name": "Contrast"
        },
        {
          "slug": "primary",
          "color": "#2563eb",
          "name": "Primary"
        },
        {
          "slug": "secondary",
          "color": "#475569",
          "name": "Secondary"
        },
        {
          "slug": "accent",
          "color": "#f8fafc",
          "name": "Accent"
        },
        {
          "slug": "primary-on-dark",
          "color": "#4a7eee",
          "name": "Primary on dark"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "inter",
          "name": "Inter",
          "fontFamily": "Inter, system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/Inter-latin-variable.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": {
            "min": "0.875rem",
            "max": "0.9375rem"
          }
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.0625rem"
          }
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.5rem",
          "fluid": {
            "min": "1.25rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Extra Large",
          "size": "2.25rem",
          "fluid": {
            "min": "1.75rem",
            "max": "2.25rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Extra Extra Large",
          "size": "3.5rem",
          "fluid": {
            "min": "2.25rem",
            "max": "3.5rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "rem",
        "px"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "20",
          "size": "1rem"
        },
        {
          "slug": "30",
          "name": "30",
          "size": "1.5rem"
        },
        {
          "slug": "40",
          "name": "40",
          "size": "2rem"
        },
        {
          "slug": "50",
          "name": "50",
          "size": "3rem"
        },
        {
          "slug": "60",
          "name": "60",
          "size": "4rem"
        },
        {
          "slug": "70",
          "name": "70",
          "size": "5rem"
        },
        {
          "slug": "80",
          "name": "80",
          "size": "6rem"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--base)"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        "border": {
          "radius": "8px"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "lineHeight": "1.1",
          "letterSpacing": "-0.02em",
          "fontWeight": "500"
        },
        "spacing": {
          "margin": {
            "top": "2rem",
            "bottom": "1rem"
          }
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "lineHeight": "1.2",
          "letterSpacing": "-0.01em",
          "fontWeight": "500"
        },
        "spacing": {
          "margin": {
            "top": "1.75rem",
            "bottom": "0.875rem"
          }
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "lineHeight": "1.3",
          "fontWeight": "500"
        },
        "spacing": {
          "margin": {
            "top": "1.5rem",
            "bottom": "0.75rem"
          }
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "lineHeight": "1.3",
          "fontWeight": "500"
        },
        "spacing": {
          "margin": {
            "top": "1.25rem",
            "bottom": "0.625rem"
          }
        }
      }
    },
    "blocks": {
      "core/paragraph": {
        "typography": {
          "lineHeight": "1.7"
        }
      }
    }
  }
}
